# Ambiente local (não versionar .env com valores reais)
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-local-only-use-32chars-min
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web

# sqlite = smoke sem Docker | postgresql = Compose / Postgres local
DJANGO_DB_ENGINE=sqlite

# PostgreSQL (obrigatório quando DJANGO_DB_ENGINE=postgresql)
POSTGRES_DB=organeasy
POSTGRES_USER=organeasy
POSTGRES_PASSWORD=organeasy-dev-only
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis (vazio = LocMemCache)
REDIS_URL=

# CORS (origens do frontend local; separadas por vírgula)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# OpenAPI/Swagger (/api/docs/, /api/schema/). Em development o default é true se omitido.
# Em produção o default é false — só ligue com decisão explícita de segurança.
DJANGO_ENABLE_API_DOCS=true

# SimpleJWT (Fase 3). Vazio em JWT_SIGNING_KEY = usa DJANGO_SECRET_KEY (só local).
JWT_ACCESS_LIFETIME_SECONDS=900
JWT_REFRESH_LIFETIME_SECONDS=604800
JWT_SIGNING_KEY=
JWT_ISSUER=organeasy-auth
JWT_AUDIENCE=organeasy-services

# Pacote B — máximo de organizações criadas por usuário (pertencer a N é livre).
ORG_CREATE_LIMIT=1
